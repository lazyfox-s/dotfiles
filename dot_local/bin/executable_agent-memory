#!/usr/bin/env python3
"""
agent-memory: Cross-project memory and knowledge management CLI for AI agents & humans.
"""

import argparse
import datetime
import json
import os
import pathlib
import sqlite3
import subprocess
import sys
from typing import Any, Dict, List

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
DEFAULT_BASE_DIR = pathlib.Path.home() / ".local" / "share" / "agent-memory"

DEFAULT_EXCLUDE_PREFIXES = [
    "ls", "pwd", "which", "type", "true", "false",
]

MAX_TITLE_LENGTH = 120


# ---------------------------------------------------------------------------
# Path & Config helpers
# ---------------------------------------------------------------------------
def get_base_dir() -> pathlib.Path:
    env = os.environ.get("AGENT_MEMORY_DIR")
    if env:
        return pathlib.Path(env).expanduser().resolve()
    return DEFAULT_BASE_DIR


def get_db_path() -> pathlib.Path:
    env = os.environ.get("AGENT_MEMORY_DB")
    if env:
        return pathlib.Path(env).expanduser().resolve()
    return get_base_dir() / "memory.db"


def get_docs_path() -> pathlib.Path:
    env = os.environ.get("AGENT_MEMORY_DOCS")
    if env:
        return pathlib.Path(env).expanduser().resolve()
    return get_base_dir() / "docs"


def get_exclude_prefixes() -> List[str]:
    """Load exclusion list: env var > config.json > defaults."""
    env = os.environ.get("AGENT_MEMORY_EXCLUDE")
    if env:
        return [p.strip() for p in env.split(",") if p.strip()]

    config_path = get_base_dir() / "config.json"
    if config_path.exists():
        try:
            with open(config_path, "r", encoding="utf-8") as f:
                config = json.load(f)
            return config.get("exclude_prefixes", DEFAULT_EXCLUDE_PREFIXES)
        except (json.JSONDecodeError, IOError):
            pass

    return list(DEFAULT_EXCLUDE_PREFIXES)


def is_excluded(command_str: str, exclude_prefixes: List[str]) -> bool:
    """Check if a command should be excluded from recording."""
    cmd_name = command_str.strip().split()[0] if command_str.strip() else ""
    cmd_basename = os.path.basename(cmd_name)
    return cmd_basename in exclude_prefixes


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
def init_db(conn: sqlite3.Connection) -> None:
    """Initialize/migrate database schema."""
    with conn:
        # Create main table (original columns)
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS logs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                created_at TEXT NOT NULL,
                project TEXT NOT NULL,
                title TEXT NOT NULL,
                details TEXT,
                tags TEXT,
                status TEXT DEFAULT 'info'
            );
            """
        )
        conn.execute("CREATE INDEX IF NOT EXISTS idx_logs_project ON logs(project);")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_logs_created_at ON logs(created_at);")

        # Migrate: add new columns to existing tables
        cursor = conn.execute("PRAGMA table_info(logs)")
        existing_cols = {row[1] for row in cursor.fetchall()}
        new_columns = {
            "command": "TEXT",
            "output": "TEXT",
            "exit_code": "INTEGER",
            "reasoning": "TEXT",
        }
        for col, col_type in new_columns.items():
            if col not in existing_cols:
                conn.execute(f"ALTER TABLE logs ADD COLUMN {col} {col_type}")

        # Rebuild FTS5 index (drop + recreate to ensure schema matches)
        conn.execute("DROP TRIGGER IF EXISTS logs_ai")
        conn.execute("DROP TRIGGER IF EXISTS logs_ad")
        conn.execute("DROP TRIGGER IF EXISTS logs_au")
        conn.execute("DROP TABLE IF EXISTS logs_fts")

        conn.execute(
            """
            CREATE VIRTUAL TABLE IF NOT EXISTS logs_fts USING fts5(
                title,
                details,
                tags,
                project,
                command,
                reasoning,
                content='logs',
                content_rowid='id'
            );
            """
        )

        # Repopulate FTS from existing data
        conn.execute(
            """
            INSERT INTO logs_fts(rowid, title, details, tags, project, command, reasoning)
            SELECT id,
                   coalesce(title, ''),
                   coalesce(details, ''),
                   coalesce(tags, ''),
                   coalesce(project, ''),
                   coalesce(command, ''),
                   coalesce(reasoning, '')
            FROM logs
            """
        )

        # Triggers to keep FTS index synced
        conn.execute(
            """
            CREATE TRIGGER IF NOT EXISTS logs_ai AFTER INSERT ON logs BEGIN
                INSERT INTO logs_fts(rowid, title, details, tags, project, command, reasoning)
                VALUES (new.id, new.title, coalesce(new.details, ''), coalesce(new.tags, ''),
                        new.project, coalesce(new.command, ''), coalesce(new.reasoning, ''));
            END;
            """
        )
        conn.execute(
            """
            CREATE TRIGGER IF NOT EXISTS logs_ad AFTER DELETE ON logs BEGIN
                INSERT INTO logs_fts(logs_fts, rowid, title, details, tags, project, command, reasoning)
                VALUES('delete', old.id, old.title, coalesce(old.details, ''), coalesce(old.tags, ''),
                       old.project, coalesce(old.command, ''), coalesce(old.reasoning, ''));
            END;
            """
        )
        conn.execute(
            """
            CREATE TRIGGER IF NOT EXISTS logs_au AFTER UPDATE ON logs BEGIN
                INSERT INTO logs_fts(logs_fts, rowid, title, details, tags, project, command, reasoning)
                VALUES('delete', old.id, old.title, coalesce(old.details, ''), coalesce(old.tags, ''),
                       old.project, coalesce(old.command, ''), coalesce(old.reasoning, ''));
                INSERT INTO logs_fts(rowid, title, details, tags, project, command, reasoning)
                VALUES (new.id, new.title, coalesce(new.details, ''), coalesce(new.tags, ''),
                        new.project, coalesce(new.command, ''), coalesce(new.reasoning, ''));
            END;
            """
        )


def get_connection() -> sqlite3.Connection:
    db_path = get_db_path()
    db_path.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(db_path))
    conn.row_factory = sqlite3.Row
    init_db(conn)
    return conn


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
def cmd_record(args: argparse.Namespace) -> None:
    details = args.details
    if not details and not sys.stdin.isatty():
        details = sys.stdin.read().strip()

    created_at = datetime.datetime.now(datetime.timezone.utc).isoformat()
    project = args.project.strip() if args.project else "global"
    title = args.title.strip()
    tags = args.tags.strip() if args.tags else ""
    status = args.status.strip() if args.status else "info"
    command = args.cmd.strip() if args.cmd else None
    reasoning = args.reasoning.strip() if args.reasoning else None

    conn = get_connection()
    with conn:
        cursor = conn.execute(
            """
            INSERT INTO logs (created_at, project, title, details, tags, status, command, reasoning)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (created_at, project, title, details, tags, status, command, reasoning),
        )
        record_id = cursor.lastrowid

    print(f"Recorded memory [ID: {record_id}] for project '{project}' (status: {status})")


def cmd_exec(args: argparse.Namespace) -> None:
    """Execute a command, capture output, and record to database."""
    if not args.command_args:
        print("Error: No command specified. Use: agent-memory exec -- <command>", file=sys.stderr)
        sys.exit(1)

    command_str = " ".join(args.command_args)
    project = args.project.strip() if args.project else "global"
    reasoning = args.reasoning.strip() if args.reasoning else None
    tags = args.tags.strip() if args.tags else ""

    # Check exclusion
    exclude_prefixes = get_exclude_prefixes()
    no_record = args.no_record or is_excluded(command_str, exclude_prefixes)

    # Execute the command
    try:
        result = subprocess.run(
            command_str,
            shell=True,
            capture_output=True,
            text=True,
        )
        stdout = result.stdout
        stderr = result.stderr
        exit_code = result.returncode
    except Exception as e:
        stdout = ""
        stderr = str(e)
        exit_code = 127

    # Output to terminal (so the calling agent/user can see it)
    if stdout:
        sys.stdout.write(stdout)
        if not stdout.endswith("\n"):
            sys.stdout.write("\n")
    if stderr:
        sys.stderr.write(stderr)
        if not stderr.endswith("\n"):
            sys.stderr.write("\n")

    # Record to database
    if not no_record:
        created_at = datetime.datetime.now(datetime.timezone.utc).isoformat()
        status = "success" if exit_code == 0 else "failed"

        # Auto-generate title
        title = reasoning if reasoning else f"$ {command_str}"
        if len(title) > MAX_TITLE_LENGTH:
            title = title[:MAX_TITLE_LENGTH - 3] + "..."

        # Combine stdout and stderr for output field
        combined_output = ""
        if stdout:
            combined_output += stdout
        if stderr:
            if combined_output:
                combined_output += "\n--- stderr ---\n"
            combined_output += stderr

        conn = get_connection()
        with conn:
            cursor = conn.execute(
                """
                INSERT INTO logs (created_at, project, title, details, tags, status,
                                  command, output, exit_code, reasoning)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (created_at, project, title, None, tags, status,
                 command_str, combined_output, exit_code, reasoning),
            )
            record_id = cursor.lastrowid

        print(f"[agent-memory] Recorded [ID: {record_id}] (exit: {exit_code})", file=sys.stderr)

    sys.exit(exit_code)


def cmd_search(args: argparse.Namespace) -> None:
    conn = get_connection()
    query = args.query.strip() if args.query else ""
    limit = max(1, args.limit)

    results: List[Dict[str, Any]] = []

    try:
        if query:
            escaped_query = query.replace('"', '""')
            safe_query = f'"{escaped_query}"'
            sql = """
                SELECT l.id, l.created_at, l.project, l.title, l.details, l.tags, l.status,
                       l.command, l.exit_code, l.reasoning
                FROM logs l
                JOIN logs_fts f ON l.id = f.rowid
                WHERE logs_fts MATCH ?
            """
            params: List[Any] = [safe_query]
        else:
            sql = """
                SELECT id, created_at, project, title, details, tags, status,
                       command, exit_code, reasoning
                FROM logs WHERE 1=1
            """
            params = []

        if args.project:
            sql += " AND project = ?"
            params.append(args.project.strip())

        if args.tags:
            tag_list = [t.strip() for t in args.tags.split(",") if t.strip()]
            for t in tag_list:
                sql += " AND tags LIKE ?"
                params.append(f"%{t}%")

        sql += " ORDER BY id DESC LIMIT ?"
        params.append(limit)

        cursor = conn.execute(sql, params)
        rows = cursor.fetchall()
        for row in rows:
            results.append(dict(row))
    except sqlite3.OperationalError:
        # Fallback to LIKE if FTS fails
        sql = """
            SELECT id, created_at, project, title, details, tags, status,
                   command, exit_code, reasoning
            FROM logs
            WHERE (title LIKE ? OR details LIKE ? OR tags LIKE ?
                   OR project LIKE ? OR command LIKE ? OR reasoning LIKE ?)
        """
        like_pattern = f"%{query}%"
        params = [like_pattern] * 6
        if args.project:
            sql += " AND project = ?"
            params.append(args.project.strip())
        sql += " ORDER BY id DESC LIMIT ?"
        params.append(limit)

        cursor = conn.execute(sql, params)
        for row in cursor.fetchall():
            results.append(dict(row))

    if args.format == "json":
        print(json.dumps(results, ensure_ascii=False, indent=2))
        return

    if not results:
        print("No matching memories found.")
        return

    print(f"Found {len(results)} memory entries:")
    for r in results:
        date_str = r["created_at"][:10]
        tags_str = f" [{r['tags']}]" if r.get("tags") else ""

        if r.get("command"):
            cmd_display = r["command"]
            if len(cmd_display) > 80:
                cmd_display = cmd_display[:77] + "..."
            label = f"$ {cmd_display}"
        else:
            label = r["title"]

        status = r.get("status", "info")
        print(f"- [ID: {r['id']}] ({date_str}) [{r['project']}]{tags_str} {label} ({status})")


def cmd_show(args: argparse.Namespace) -> None:
    conn = get_connection()
    cursor = conn.execute(
        """SELECT id, created_at, project, title, details, tags, status,
                  command, output, exit_code, reasoning
           FROM logs WHERE id = ?""",
        (args.id,),
    )
    row = cursor.fetchone()
    if not row:
        print(f"Memory with ID {args.id} not found.", file=sys.stderr)
        sys.exit(1)

    r = dict(row)
    if args.format == "json":
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return

    print(f"# Memory Entry [ID: {r['id']}]")
    print(f"- **Created At**: {r['created_at']}")
    print(f"- **Project**: {r['project']}")
    print(f"- **Status**: {r['status']}")
    if r.get("tags"):
        print(f"- **Tags**: {r['tags']}")
    print(f"- **Title**: {r['title']}")

    if r.get("reasoning"):
        print(f"\n## Reasoning\n")
        print(r["reasoning"])

    if r.get("command"):
        print(f"\n## Command\n")
        print(f"```\n{r['command']}\n```")

    if r.get("exit_code") is not None:
        print(f"\n- **Exit Code**: {r['exit_code']}")

    if r.get("output"):
        print(f"\n## Output\n")
        print(f"```\n{r['output']}\n```")

    if r.get("details"):
        print(f"\n## Details\n")
        print(r["details"])


def cmd_init_docs(args: argparse.Namespace) -> None:
    docs_dir = get_docs_path()
    tips_dir = docs_dir / "tips"
    decisions_dir = docs_dir / "decisions"

    tips_dir.mkdir(parents=True, exist_ok=True)
    decisions_dir.mkdir(parents=True, exist_ok=True)

    readme_path = docs_dir / "README.md"
    if not readme_path.exists():
        readme_path.write_text(
            "# Cross-Project Shared Knowledge Base\n\n"
            "This directory contains curated markdown knowledge, tips, and architectural decisions "
            "shared across projects.\n\n"
            "- `tips/`: Tool-specific bug workarounds, tips, and configuration snippets.\n"
            "- `decisions/`: Cross-project design decisions and architectural notes.\n",
            encoding="utf-8",
        )

    sample_tip = tips_dir / "sample-tool-tips.md"
    if not sample_tip.exists():
        sample_tip.write_text(
            "# Sample Tool Tips & Workarounds\n\n"
            "## Summary\n"
            "Quick notes on common tool quirks and solutions.\n\n"
            "## Known Issues & Fixes\n"
            "- **Issue**: Example error message or bug.\n"
            "  - **Fix**: Description of how to resolve it.\n",
            encoding="utf-8",
        )

    print(f"Initialized knowledge base at: {docs_dir}")
    print(f"- {tips_dir}")
    print(f"- {decisions_dir}")
    print(f"- {readme_path}")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
def main() -> None:
    parser = argparse.ArgumentParser(
        description="agent-memory: Cross-project memory and knowledge CLI for AI agents & humans."
    )
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    # --- record ---
    p_record = subparsers.add_parser("record", help="Record a new memory/execution log.")
    p_record.add_argument("--project", "-p", default="global", help="Project name.")
    p_record.add_argument("--title", "-t", required=True, help="Short title / summary.")
    p_record.add_argument("--details", "-d", help="Detailed content (or pass via stdin).")
    p_record.add_argument("--tags", help="Comma-separated tags.")
    p_record.add_argument("--cmd", help="Command that was executed (for manual recording).")
    p_record.add_argument("--reasoning", "-r", help="Reasoning / thought process.")
    p_record.add_argument(
        "--status",
        choices=["info", "success", "failed", "warning"],
        default="info",
        help="Status (default: info).",
    )
    p_record.set_defaults(func=cmd_record)

    # --- exec ---
    p_exec = subparsers.add_parser(
        "exec",
        help="Execute a command, capture & record its output automatically.",
    )
    p_exec.add_argument("--project", "-p", default="global", help="Project name.")
    p_exec.add_argument("--reasoning", "-r", help="Why this command is being run.")
    p_exec.add_argument("--tags", help="Comma-separated tags.")
    p_exec.add_argument(
        "--no-record", action="store_true",
        help="Skip recording for this invocation.",
    )
    p_exec.add_argument(
        "command_args", nargs=argparse.REMAINDER,
        help="Command to execute (after --).",
    )
    p_exec.set_defaults(func=cmd_exec)

    # --- search ---
    p_search = subparsers.add_parser("search", help="Search memory records.")
    p_search.add_argument("query", nargs="?", default="", help="Search keywords.")
    p_search.add_argument("--project", "-p", help="Filter by project name.")
    p_search.add_argument("--tags", help="Filter by tag (comma-separated).")
    p_search.add_argument("--limit", "-n", type=int, default=5, help="Max results (default: 5).")
    p_search.add_argument(
        "--format", "-f", choices=["markdown", "json"], default="markdown",
        help="Output format.",
    )
    p_search.set_defaults(func=cmd_search)

    # --- show ---
    p_show = subparsers.add_parser("show", help="Show full details of a memory record.")
    p_show.add_argument("id", type=int, help="Memory record ID.")
    p_show.add_argument(
        "--format", "-f", choices=["markdown", "json"], default="markdown",
        help="Output format.",
    )
    p_show.set_defaults(func=cmd_show)

    # --- init-docs ---
    p_init = subparsers.add_parser("init-docs", help="Initialize Markdown knowledge base directories.")
    p_init.set_defaults(func=cmd_init_docs)

    args = parser.parse_args()

    # Strip leading "--" from exec command_args
    if hasattr(args, "command_args") and args.command_args and args.command_args[0] == "--":
        args.command_args = args.command_args[1:]

    args.func(args)


if __name__ == "__main__":
    main()
